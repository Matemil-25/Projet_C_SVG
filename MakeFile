CC = gcc

CFLAGS = -Wall -Wextra -Werror -std=c99 -fstack-protector

SRC = main.c\

OBJS = $(SRC:.c=.o)

NAME = projet

all:$(Name)

$(Name): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $(NAME)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re