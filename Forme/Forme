#include <stdlib.h>
#include <stdio.h>
#include <stdint.h>

//==========Enumeration==========
// faire une enumeration de toute les forme

typedef enum Forme_E
{
    Rectangle,
    Ellipse,
    Line,
    Polyline,
}Forme_T;

//==========Structure==========
//Structure Point

typedef struct Point_S
{
    int A;
    int B;
}Point_T;

// creer la structure qui va accueilir les formes 

typedef struct Forme_S
{
    Forme_T Forme;
    int X;
    int Y;
    int Width;
    int Height;
    int Stroke_Weidth;
    int fill;
    int Stroke;
    int R;
    int Xr;
    int Yr;
    Point_T Points []; 
}Forme ;

//==========Fonction==========
//Fonction: choix de la forme

Forme_T Choix (void)
{
    int Choice = 0; 
    Forme_T F;

    while (Choice == 0)
    {
        printf("Which form do you want to create ?\n");
        printf("1-Rectangle             3-line\n");
        printf("2-Ellipse/Circle        4-Polygon/Polyline\n");
        printf(" : ");
        scanf("%d", &Choice);

        switch (Choice)
        {
            case 1 : F = Rectangle; break;
            case 2: F = Ellipse; break;
            case 3: F = Line; break;
            case 4: F = Polyline; break;
            default: printf("Ce n'est pas dans les choix\n"); break;
        }
    }
    
    return F;
}

//Constructeur de forme

Forme Constructeur (Forme_T F)
{
    Forme Fo;
    
    switch(F)
    {
        case Rectangle : 
            Fo.R = 0;
            Fo.Xr = 0;
            Fo.Yr = 0;
            Fo.Points[0];
        case Ellipse :
            Fo.R = 0;
            Fo.Width = 0;
            Fo.Height = 0;
            Fo.Points[0];
        case Line :
            Fo.Width = 0;
            Fo.Height = 0;
            Fo.Xr = 0;
            Fo.Yr = 0;
            Fo.R = 0;
        case Polyline :
            Fo.Width = 0;
            Fo.Height = 0;
            Fo.R = 0;
            Fo.Xr = 0;
            Fo.Yr = 0;
    }
    return Fo ;
}

int Add_Form (Forme Fo)
{
    FILE* Pointeur_File;
    Pointeur_File = fopen("Html_File/Projet_1.html","w");
    switch (Fo.Forme)
    {
    case Rectangle:
        printf("Choose your settings : \n");
        scanf("X : %d\n",&Fo.X);
        scanf("Y : %d\n",&Fo.Y);
        scanf("Width : %d\n",&Fo.Width);
        scanf("Height : %d\n",&Fo.Height);
        fprintf(Pointeur_File,"<rect x=\"%d\" y=\"%d\" width=\"%d\" height=\"%d\" />", &Fo.X, &Fo.Y, &Fo.Width ,&Fo.Height);
        break;
    default : 
        printf("\n Invalid Form \n");
        break;
    }
    fprintf(Pointeur_File,"</svg>");
}