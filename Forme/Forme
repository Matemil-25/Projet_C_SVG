//==========Fonction==========
//Fonction: choix de la forme

Forme_T Choix (void)
{
    int Choice = 0; 
    Forme_T F;

    while (Choice == 0)
    {
        printf("Which form do you want to create ?\n");
        printf("1-Rectangle     4-Line\n");
        printf("2-Ellipse       5-Polyline\n");
        printf("3-Circle        6-Polygon\n");
        printf(" : ");
        scanf("%d", &Choice);

        switch (Choice)
        {
            case 1 : F = Rectangle; break;
            case 2: F = Ellipse; break;
            case 3: F = Circle; break;
            case 4: F = Line; break;
            case 5: F = Polyline; break;
            case 6: F = Polygon; break;
            default: printf("Ce n'est pas dans les choix\n"); break;
        }
    }
    
    return F;
}

